  "framework": null,
  "buildCommand": "node scripts/build-release.cjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
