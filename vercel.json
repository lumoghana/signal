{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "build": {
    "env": {
      "VERCEL_PYTHON_DISABLE_RUNTIME_INSTALL": "1"
    }
  },
  "buildCommand": "node scripts/prepare-approved-public-assets.mjs && node scripts/prepare-approved-download.mjs && node scripts/build-offline-shell.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://iwutbrljiiodamtyoorg.supabase.co; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https://chatgpt.com https://*.chatgpt.com"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=()"
        }
      ]
    }
  ],
  "functions": {
    "api/web-session.mjs": {
      "maxDuration": 30
    },
    "api/face.py": {
      "maxDuration": 30,
      "includeFiles": "face_service/{*.py,models/**,model-manifest.json}",
      "excludeFiles": "{face_service/tests/**,dist/**,backend/**,merchant-approved/**,verification/**,build-inputs/**}"
    }
  }
}
