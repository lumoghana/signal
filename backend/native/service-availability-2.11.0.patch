+    private static final String UNAVAILABLE="This payment option is temporarily unavailable. Please use another method or try again later.";
+    private final HashMap<String,Entry> services=new HashMap<>();
+    private long receivedAt=-1;
+    private long serverAt=-1;
+    private static final class Entry {boolean available;String message;long serverAt;}
+
+    public synchronized boolean accept(JSONObject reply,long now){
+        if(reply==null||!reply.optBoolean("ok"))return false;
+        JSONArray rows=reply.optJSONArray("services");
+        JSONObject capabilities=reply.optJSONObject("capabilities");
+        if(rows==null&&capabilities!=null)rows=capabilities.optJSONArray("serviceAvailability");
+        if(rows==null||rows.length()==0)return false;
+        long envelopeAt=stamp(reply.optString("checkedAt"));
+        HashMap<String,Entry> next=new HashMap<>();
+        for(int i=0;i<rows.length();i++){
+            JSONObject row=rows.optJSONObject(i);if(row==null)continue;
+            String id=row.optString("serviceId",row.optString("id"));
+            if(!id.matches("[a-z][a-z0-9_]{0,79}")||!(row.opt("available") instanceof Boolean))continue;
+            Entry entry=new Entry();
+            String mode=row.optString("mode"),status=row.optString("status");
+            entry.available=row.optBoolean("available")&&mode.equals("automatic")&&status.equals("healthy")&&!row.optString("providerMode").equals("unavailable");
+            entry.message=clean(row.optString("message"));
+            entry.serverAt=Math.max(envelopeAt,Math.max(stamp(row.optString("updatedAt")),stamp(row.optString("lastCheckedAt"))));
+            Entry previous=services.get(id);
+            if(previous!=null&&previous.serverAt>entry.serverAt)next.put(id,previous);else next.put(id,entry);
+        }
+        if(next.isEmpty())return false;
+        if(envelopeAt>=0&&serverAt>envelopeAt)return false;
+        String before=signature();services.clear();services.putAll(next);receivedAt=now;serverAt=Math.max(serverAt,envelopeAt);
+        return !before.equals(signature());
+    }
+    public synchronized boolean fresh(long now){return receivedAt>=0&&now>=receivedAt&&now-receivedAt<=FRESH_FOR_MS;}
+    public synchronized boolean available(String id,long now){Entry entry=services.get(id);return fresh(now)&&entry!=null&&entry.available;}
+    public synchronized String message(String id,long now){Entry entry=services.get(id);if(!fresh(now)||entry==null)return CHECKING;return entry.available?"":entry.message.isEmpty()?UNAVAILABLE:entry.message;}
+    public synchronized boolean paymentAvailable(String rail,String network,long now){String base=forRail(rail);if(base.isEmpty())return true;if(!available(base,now))return false;String scoped=networkService(rail,network);return scoped.isEmpty()||available(scoped,now);}
